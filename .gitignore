# ==========================================
# MediBot Root .gitignore
# Covers Python backend, Next.js frontend,
# vector storage, environments & OS files
# ==========================================

# Environment variables & secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
*.pem
*.key

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Python packaging & distribution
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Unit tests, coverage & linters
.pytest_cache/
.tox/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
.ipynb_checkpoints/

# Vector database & runtime caches
qdrant_storage/
**/qdrant_storage/
*.lock

# SQLite runtime locks & journals (preserve seed database mediassist.db)
*.db-journal
*.db-wal
*.db-shm
*.sqlite-journal
!mediassist_data/db/mediassist.db

# Node dependencies & caches
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
.next/
**/.next/
out/
**/out/
.vercel/

# Logs & debug traces
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDEs and Editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
