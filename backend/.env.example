# MediBot Backend Environment Configuration
# Copy this file to .env and insert your actual credentials:
# cp .env.example .env

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Embeddings & Reranker Models
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Security / Authentication
JWT_SECRET=your_jwt_secret_key_here

# Paths
QDRANT_STORAGE_PATH=backend/qdrant_storage
DATABASE_PATH=mediassist_data/db/mediassist.db
